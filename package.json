{
  "name": "pi-hot-idle-compaction",
  "version": "0.1.1",
  "description": "Pi extension that keeps long sessions cheap across idle gaps: cache-hitting summaries, lazy tool-result stubbing, and cost-capped keepalives.",
  "keywords": [
    "compaction",
    "pi-extension",
    "pi-package",
    "prompt-cache"
  ],
  "homepage": "https://github.com/lytedev/pi-hot-idle-compaction#readme",
  "bugs": {
    "url": "https://github.com/lytedev/pi-hot-idle-compaction/issues"
  },
  "license": "MIT",
  "author": "Daniel Flanagan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lytedev/pi-hot-idle-compaction.git"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "test": "vp test",
    "check": "vp check",
    "format": "vp fmt",
    "format:check": "vp fmt --check"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "^24.0.0",
    "vite-plus": "^1.4.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": ">=1.4.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.0.5"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/lytedev/pi-hot-idle-compaction/3fd202c35b99a96cb095e22d59de638c67c82dc9/docs/hot-idle-status.png"
  }
}
