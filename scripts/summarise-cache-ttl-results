#!/usr/bin/env node
// Prints a markdown table from the JSON files written by measure-provider-cache-ttl.
//   scripts/summarise-cache-ttl-results results/pro-streamlake.json results/flash-deepinfra.json

import { readFileSync } from "node:fs";

for (const path of process.argv.slice(2)) {
  const results = JSON.parse(readFileSync(path, "utf8"));
  console.log(`\n${results.model} pinned to ${results.pinnedProviderSlug} (started ${results.startedAt})\n`);
  console.log("| gap (min) | prompt tokens | cached on immediate control | cached after gap | verdict |");
  console.log("| --- | --- | --- | --- | --- |");
  const gaps = [...results.gaps].sort((first, second) => first.gapMinutes - second.gapMinutes);
  for (const gap of gaps) {
    const byLabel = Object.fromEntries(gap.calls.map((call) => [call.label, call]));
    const controlCached = byLabel.control?.cachedTokens;
    const probeCached = byLabel.probe?.cachedTokens;
    let verdict = "pending";
    if (probeCached !== undefined) {
      if (!controlCached) verdict = "control missed, inconclusive";
      else verdict = probeCached >= 0.8 * controlCached ? "still cached" : "expired";
    }
    console.log(
      `| ${gap.gapMinutes} | ${byLabel.write?.promptTokens ?? "?"} | ${controlCached ?? "?"} | ${probeCached ?? "pending"} | ${verdict} |`,
    );
  }
}
