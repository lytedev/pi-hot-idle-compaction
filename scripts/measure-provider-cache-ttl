#!/usr/bin/env node
// Measures how long an OpenRouter provider keeps a prompt prefix cached.
//
// For each idle gap it writes a fresh, unique prefix, waits the gap, resends the identical
// prefix, and records how many prompt tokens the provider reported as cached. All gaps run in
// parallel and the JSON results file is rewritten after every call, so a partial run is usable.
//
// Usage:
//   scripts/measure-provider-cache-ttl --model deepseek/deepseek-v4-pro-0813 \
//     --provider-slug streamlake --out results/pro-streamlake.json
//
// Environment:
//   OPENROUTER_CHAT_COMPLETIONS_URL  default http://127.0.0.1:4100/v1/chat/completions
//   OPENROUTER_API_KEY               optional; sent as a bearer token when set
//   EXTRA_REQUEST_HEADERS_JSON       default {"x-pi-provider":"openrouter"}

import { randomBytes } from "node:crypto";
import { mkdirSync, writeFileSync } from "node:fs";
import { dirname } from "node:path";
import { parseArgs } from "node:util";

const { values: options } = parseArgs({
  options: {
    model: { type: "string" },
    "provider-slug": { type: "string" },
    out: { type: "string" },
    "prefix-words": { type: "string", default: "6700" },
    "gap-minutes": { type: "string", default: "5,10,30,60,120,240,480" },
    "control-delay-seconds": { type: "string", default: "8" },
  },
});

for (const required of ["model", "provider-slug", "out"]         ) {
  if (!options[required]) {
    console.error(`missing --${required}`);
    process.exit(2);
  }
}

const chatCompletionsUrl =
  process.env.OPENROUTER_CHAT_COMPLETIONS_URL ?? "http://127.0.0.1:4100/v1/chat/completions";
const requestHeaders                         = {
  "content-type": "application/json",
  ...JSON.parse(process.env.EXTRA_REQUEST_HEADERS_JSON ?? '{"x-pi-provider":"openrouter"}'),
};
if (process.env.OPENROUTER_API_KEY) {
  requestHeaders.authorization = `Bearer ${process.env.OPENROUTER_API_KEY}`;
}

const gapMinutes = options["gap-minutes"] .split(",").map(Number);
const controlDelayMilliseconds = Number(options["control-delay-seconds"]) * 1000;
const prefixWords = Number(options["prefix-words"]);
const outputPath = options.out ;

                   
                                       
             
                            
                        
                        
                            
                       
                 
  
                                                                                  

const results   
                
                             
                    
                    
  = {
  model: options.model ,
  pinnedProviderSlug: options["provider-slug"] ,
  startedAt: new Date().toISOString(),
  gaps: [],
};

function persist() {
  mkdirSync(dirname(outputPath), { recursive: true });
  writeFileSync(outputPath, `${JSON.stringify(results, null, 2)}\n`);
}

function sleep(milliseconds        ) {
  return new Promise((resolve) => setTimeout(resolve, milliseconds));
}

function uniquePrefix(nonce        ) {
  const words           = [`Reference corpus ${nonce}.`];
  for (let wordIndex = 0; wordIndex < prefixWords; wordIndex++) {
    words.push(randomBytes(3).toString("hex"));
  }
  return words.join(" ");
}

async function sendRequest(prefix        , label                     )                      {
  const record             = { label, at: new Date().toISOString() };
  for (let attempt = 1; attempt <= 4; attempt++) {
    try {
      const response = await fetch(chatCompletionsUrl, {
        method: "POST",
        headers: requestHeaders,
        body: JSON.stringify({
          model: options.model,
          max_tokens: 1,
          messages: [
            { role: "user", content: `${prefix}\n\nReply with the single word: ok` },
          ],
          provider: { order: [options["provider-slug"]], allow_fallbacks: false },
        }),
      });
      const body      = await response.json();
      if (!response.ok || body.error) {
        throw new Error(`HTTP ${response.status}: ${JSON.stringify(body).slice(0, 300)}`);
      }
      record.servedByProvider = body.provider;
      record.promptTokens = body.usage?.prompt_tokens;
      record.cachedTokens = body.usage?.prompt_tokens_details?.cached_tokens;
      record.cacheWriteTokens = body.usage?.prompt_tokens_details?.cache_write_tokens;
      record.costDollars = body.usage?.cost;
      return record;
    } catch (error) {
      record.error = String(error);
      await sleep(5000 * attempt);
    }
  }
  return record;
}

async function runGap(gap        ) {
  const prefixNonce = randomBytes(8).toString("hex");
  const prefix = uniquePrefix(prefixNonce);
  const gapRecord            = { gapMinutes: gap, prefixNonce, calls: [] };
  results.gaps.push(gapRecord);

  gapRecord.calls.push(await sendRequest(prefix, "write"));
  persist();
  await sleep(controlDelayMilliseconds);
  gapRecord.calls.push(await sendRequest(prefix, "control"));
  persist();
  await sleep(gap * 60_000);
  gapRecord.calls.push(await sendRequest(prefix, "probe"));
  persist();
}

await Promise.all(gapMinutes.map(runGap));
results.gaps.sort((first, second) => first.gapMinutes - second.gapMinutes);
persist();
console.log(`done: ${outputPath}`);
