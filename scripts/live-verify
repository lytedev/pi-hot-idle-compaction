#!/usr/bin/env node
// Drives a real pi process over RPC against a real model to verify the extension end to end.
//
//   scripts/live-verify --scenario stubbing|threshold|idle-summary \
//     --agent-template <dir with models.json, agentgateway.json, extensions/> \
//     --fixtures <dir with notes-NN.txt files> --out results/live-<scenario>.json
//
// The agent template is copied, never modified. Settings under "hotIdleCompaction" are
// supplied per scenario below, with a deliberately short simulated prompt-cache lifetime so
// the scenarios finish in minutes rather than hours. Real money is spent on every run.

import { spawn } from "node:child_process";
import { cpSync, mkdirSync, mkdtempSync, readdirSync, readFileSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { dirname, join, resolve } from "node:path";
import { parseArgs } from "node:util";

const { values: options } = parseArgs({
  options: {
    scenario: { type: "string" },
    "agent-template": { type: "string" },
    fixtures: { type: "string" },
    out: { type: "string" },
    model: { type: "string", default: "deepseek/deepseek-v4-pro-0813" },
    provider: { type: "string", default: "openrouter-gateway" },
  },
});
for (const required of ["scenario", "agent-template", "fixtures", "out"]) {
  if (!options[required]) {
    console.error(`missing --${required}`);
    process.exit(2);
  }
}

const repositoryRoot = resolve(dirname(new URL(import.meta.url).pathname), "..");
const baseSettings = {
  defaultProvider: options.provider,
  defaultModel: options.model,
  defaultThinkingLevel: "off",
  transport: "sse",
  cacheWarming: "off",
  compaction: { enabled: true, reserveTokens: 16384, keepRecentTokens: 6000 },
};
const scenarios = {
  stubbing: {
    hotIdleCompaction: {
      ttlSeconds: 120,
      minContextTokens: 15000,
      compactAtTokens: 500000,
      idleSummary: { enabled: false },
      stubbing: {
        graceSeconds: 10,
        keepMostRecentToolUses: 3,
        minimumTokensCleared: 8000,
        minimumFractionOfContextCleared: 0.25,
      },
    },
  },
  threshold: {
    hotIdleCompaction: {
      ttlSeconds: 600,
      minContextTokens: 15000,
      compactAtTokens: 70000,
      idleSummary: { enabled: false },
      stubbing: { enabled: false },
    },
  },
  "idle-summary": {
    hotIdleCompaction: {
      ttlSeconds: 120,
      minContextTokens: 15000,
      compactAtTokens: 500000,
      idleSummary: { enabled: true, minContextTokens: 20000 },
      stubbing: { enabled: false },
    },
  },
};
const scenarioSettings = scenarios[options.scenario];
if (!scenarioSettings) {
  console.error(`unknown scenario ${options.scenario}`);
  process.exit(2);
}

const workingDirectory = mkdtempSync(join(tmpdir(), "hot-idle-live-"));
const agentDirectory = join(workingDirectory, "agent");
const sessionDirectory = join(workingDirectory, "sessions");
const projectDirectory = join(workingDirectory, "project");
cpSync(resolve(options["agent-template"]), agentDirectory, { recursive: true });
cpSync(resolve(options.fixtures), projectDirectory, { recursive: true });
mkdirSync(sessionDirectory, { recursive: true });
writeFileSync(
  join(agentDirectory, "settings.json"),
  JSON.stringify({ ...baseSettings, ...scenarioSettings }, null, 2),
);

const piProcess = spawn(
  "pi",
  [
    "--mode",
    "rpc",
    "-e",
    join(repositoryRoot, "src", "index.ts"),
    "--session-dir",
    sessionDirectory,
  ],
  {
    cwd: projectDirectory,
    env: { ...process.env, PI_CODING_AGENT_DIR: agentDirectory },
    stdio: ["pipe", "pipe", "pipe"],
  },
);

const eventLog = [];
let stdoutBuffer = "";
piProcess.stdout.on("data", (chunk) => {
  stdoutBuffer += chunk.toString("utf8");
  let newline;
  while ((newline = stdoutBuffer.indexOf("\n")) >= 0) {
    const line = stdoutBuffer.slice(0, newline);
    stdoutBuffer = stdoutBuffer.slice(newline + 1);
    if (line.trim() === "") continue;
    try {
      const record = JSON.parse(line);
      eventLog.push({ receivedAt: Date.now(), record });
    } catch {
      eventLog.push({ receivedAt: Date.now(), unparsed: line });
    }
  }
});
let stderrText = "";
piProcess.stderr.on("data", (chunk) => {
  stderrText += chunk.toString("utf8");
});

function send(command) {
  piProcess.stdin.write(`${JSON.stringify(command)}\n`);
}

function sleep(milliseconds) {
  return new Promise((resolveSleep) => setTimeout(resolveSleep, milliseconds));
}

async function waitUntil(description, predicate, timeoutMilliseconds) {
  const deadline = Date.now() + timeoutMilliseconds;
  while (Date.now() < deadline) {
    const found = predicate();
    if (found) return found;
    await sleep(500);
  }
  throw new Error(`timed out after ${timeoutMilliseconds}ms waiting for ${description}`);
}

function eventsOfType(type) {
  return eventLog.filter((entry) => entry.record?.type === type);
}

async function promptAndWaitUntilSettled(message) {
  const settledBefore = eventsOfType("agent_settled").length;
  send({ type: "prompt", message });
  await waitUntil(
    `agent_settled after prompt "${message.slice(0, 40)}"`,
    () => eventsOfType("agent_settled").length > settledBefore,
    15 * 60_000,
  );
}

function readFilesPrompt(fromIndex, toIndex) {
  const names = [];
  for (let index = fromIndex; index <= toIndex; index++) {
    names.push(`notes-${String(index).padStart(2, "0")}.txt`);
  }
  return `Use the read tool on each of these files IN FULL (never pass offset or limit; you need the whole file contents in context), one call per file, in order, and issue exactly ONE tool call per assistant turn (never several in parallel), waiting for each result before the next: ${names.join(", ")}. Then answer with one line per file giving the KEYWORD from its first line. Do not summarise anything else.`;
}

const scenarioSteps = {
  async stubbing() {
    await promptAndWaitUntilSettled(readFilesPrompt(0, 7));
    const idleSeconds = 140;
    console.error(`idling ${idleSeconds}s so the simulated 120s cache lifetime plus 10s grace elapses`);
    await sleep(idleSeconds * 1000);
    await promptAndWaitUntilSettled(
      "Using only what you already know (do not call tools), repeat the KEYWORD for notes-00.txt and notes-07.txt. If a file's output was removed, say so.",
    );
    await promptAndWaitUntilSettled(
      "Without calling tools, repeat the KEYWORD for notes-07.txt once more.",
    );
    await promptAndWaitUntilSettled(
      "Without calling tools, repeat the KEYWORD for notes-07.txt a third time.",
    );
  },
  async threshold() {
    await promptAndWaitUntilSettled(readFilesPrompt(0, 9));
    await sleep(15_000);
    await promptAndWaitUntilSettled(
      "Without calling tools, what did we do so far? One sentence.",
    );
  },
  async "idle-summary"() {
    await promptAndWaitUntilSettled(readFilesPrompt(0, 5));
    const waitSeconds = 100;
    console.error(`waiting ${waitSeconds}s for the idle summary scheduled 60s after the last activity`);
    await sleep(waitSeconds * 1000);
    await promptAndWaitUntilSettled(
      "Without calling tools, what did we do so far? One sentence.",
    );
  },
};

let failure;
try {
  await sleep(4000);
  await scenarioSteps[options.scenario]();
  send({ type: "prompt", message: "/hot-idle" });
  await sleep(3000);
} catch (error) {
  failure = String(error);
}
piProcess.stdin.end();
await sleep(3000);
piProcess.kill();

const sessionFiles = readdirSync(sessionDirectory, { recursive: true }).filter((name) =>
  String(name).endsWith(".jsonl"),
);
const sessionEntries = sessionFiles.flatMap((name) =>
  readFileSync(join(sessionDirectory, String(name)), "utf8")
    .split("\n")
    .filter(Boolean)
    .map((line) => JSON.parse(line)),
);

const assistantCalls = sessionEntries
  .filter((entry) => entry.type === "message" && entry.message?.role === "assistant")
  .map((entry, index) => ({
    index,
    input: entry.message.usage?.input,
    cacheRead: entry.message.usage?.cacheRead,
    cacheWrite: entry.message.usage?.cacheWrite,
    output: entry.message.usage?.output,
    costDollars: entry.message.usage?.cost?.total,
    stopReason: entry.message.stopReason,
  }));
const hotIdleEntries = sessionEntries.filter(
  (entry) => entry.type === "custom" && String(entry.customType).startsWith("hot-idle"),
);
const compactionEntries = sessionEntries
  .filter((entry) => entry.type === "compaction")
  .map((entry) => ({
    tokensBefore: entry.tokensBefore,
    usage: entry.usage,
    fromHook: entry.fromHook,
    details: entry.details,
    summaryHead: String(entry.summary).slice(0, 400),
  }));
const notifications = eventsOfType("extension_ui_request")
  .map((entry) => entry.record)
  .filter((record) => record.method === "notify")
  .map((record) => record.message);
const totalCostDollars =
  assistantCalls.reduce((sum, call) => sum + (call.costDollars ?? 0), 0) +
  compactionEntries.reduce((sum, entry) => sum + (entry.usage?.cost?.total ?? 0), 0);

const report = {
  scenario: options.scenario,
  failure,
  totalCostDollars,
  assistantCalls,
  hotIdleEntries,
  compactionEntries,
  notifications,
  stderrTail: stderrText.slice(-1500),
};
mkdirSync(dirname(resolve(options.out)), { recursive: true });
writeFileSync(resolve(options.out), `${JSON.stringify(report, null, 2)}\n`);
console.log(JSON.stringify({ ...report, hotIdleEntries: hotIdleEntries.length, stderrTail: undefined }, null, 1));
